# Golden access / segregation-of-duties cases (obviously fictional). Fields: id, request_ref,
# subject_ref, requested_role, current_entitlements, expected_eligible, expected_conflicts.
# The expected_* fields are the INDEPENDENT ORACLE, hand-labelled from the reviewed policy pack
# and never read back from the engine: sod_precision scores how many grants the engine BLOCKED
# that were truly ineligible, so a wildcard conflict that blocks a clean grant drives it red.
# Every subject reference is opaque and fictional; no real person or identifier appears. The
# adversarial cases (a7, a11) hold a payment entitlement but request a benign or non-conflicting
# role, so a precise engine must NOT block them; the toxic cases (a2, a3, a4, a5, a10) only
# conflict once the requested role is unioned with what the subject already holds.
{"id": "a1", "request_ref": "REQ-0001", "subject_ref": "person-0001", "requested_role": "service_desk_agent", "current_entitlements": [], "expected_eligible": true, "expected_conflicts": []}
{"id": "a2", "request_ref": "REQ-0002", "subject_ref": "person-0002", "requested_role": "payments_maker", "current_entitlements": ["payment.approve"], "expected_eligible": false, "expected_conflicts": ["sod-pay-maker-checker"]}
